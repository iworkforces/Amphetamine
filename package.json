{
  "name": "amphetamine",
  "version": "1.13.1",
  "author": "iWorkforces Engineers",
  "authorEmail": "chitrung09t2@gmail.com",
  "description": "A tray app that keeps your computer awake on macOS and Windows. Lives in the system tray, prevents the system from going to sleep, and stays out of the Dock/taskbar when idle.",
  "repository": "https://github.com/iWorkforces/Amphetamine",
  "main": "lib/main/index.cjs",
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.2.9",
    "@rslib/core": "^1.0.2",
    "@rspack/core": "^2.2.7",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=26 <27",
    "bun": ">=1.4.2"
  },
  "homepage": "https://github.com/iWorkforces/Amphetamine",
  "packageManager": "bun@1.4.2",
  "private": true,
  "productName": "Amphetamine",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build-production.ts",
    "benchmark:performance": "bun run scripts/benchmark-performance.ts",
    "build:main": "NODE_ENV=production rslib build -c rslib.config.ts",
    "build:preload": "NODE_ENV=production rslib build -c rslib.config.preload.ts",
    "build:renderer": "NODE_ENV=production rsbuild build",
    "package": "bun run build && electron-builder --mac --arm64 && node build/flip-fuses.cjs mac arm64",
    "package:x64": "bun run build && electron-builder --mac --x64 && node build/flip-fuses.cjs mac x64",
    "package:universal": "bun run build && electron-builder --mac --universal && node build/flip-fuses.cjs mac universal",
    "package:dir": "bun run build && electron-builder --mac --arm64 --dir",
    "package:win": "bun run build && electron-builder --win --x64 && node build/flip-fuses.cjs win x64",
    "package:win:dir": "bun run build && electron-builder --win --x64 --dir",
    "package:win:arm64": "bun run build && electron-builder --win --arm64 && node build/flip-fuses.cjs win arm64",
    "package:win:dir:arm64": "bun run build && electron-builder --win --arm64 --dir",
    "flip-fuses": "node build/flip-fuses.cjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -b",
    "typecheck:tests": "node node_modules/@typescript/native/bin/tsc --project tsconfig.tests.json --noEmit",
    "typecheck:sticky": "node scripts/check-sticky-ts.mjs",
    "typecheck:layers": "node scripts/check-layer-imports.mjs",
    "test": "vitest run -c vitest.workspace.ts",
    "test:watch": "vitest -c vitest.workspace.ts",
    "test:coverage": "vitest run -c vitest.workspace.ts --coverage",
    "clean": "rimraf lib dist",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --cache --write 'src/**/*.{ts,html,css}' 'tests/**/*.ts'",
    "check": "bun run typecheck && bun run typecheck:tests && bun run typecheck:sticky && bun run typecheck:layers && bun run lint && bun run test"
  },
  "sideEffects": false,
  "type": "module",
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  }
}
